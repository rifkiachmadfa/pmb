  * Term 3 mentions receiving a password; the wording still needs school/owner
diff --git a/src/features/registration/student-schema.ts b/src/features/registration/student-schema.ts
index dfe6f4c..91548a6 100644
--- a/src/features/registration/student-schema.ts
+++ b/src/features/registration/student-schema.ts
@@ -140,14 +140,14 @@ export const STUDENT_ERROR_ORDER: readonly StudentErrorKey[] = STUDENT_FIELDS.fl
 const REQUIRED = "Wajib diisi.";
 const PICK = "Pilih salah satu pilihan.";
 
-const NAME_RE = /^[\p{L}\p{M}][\p{L}\p{M} .,'’-]*$/u;
+export const NAME_RE = /^[\p{L}\p{M}][\p{L}\p{M} .,'’-]*$/u;

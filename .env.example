# Copy to .env (never commit .env). Placeholders only — no real secrets here.

# Supabase PostgreSQL.
# NOTE: exact hostnames/ports/pooler mode must be confirmed from the Supabase
# project dashboard; the values below are placeholders, not verified.
#
# Pooled connection used by the running app (transaction pooler).
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres"
# Direct or session-mode connection used only by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres"

# Public base URL of the app (optional in Phase 1).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Auth (Google sign-in). Both are PUBLIC values from
# Supabase dashboard > Project Settings > API (Project URL + publishable key).
# Never put the service-role / secret key here.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Added in later phases (do not set yet):
#   Phase 6  : Midtrans server key / client key / environment
#   Phase 7  : Fonnte token
